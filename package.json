{
  "name": "padel-finder-mcp",
  "version": "2.0.0",
  "description": "MCP server for finding available padel courts via Playtomic",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "padel-finder-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:widgets && npm run build:server",
    "build:widgets": "vite build --config vite.widgets.config.ts",
    "build:server": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:stdio": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "demo:widgets": "tsx src/demo/widget-demo.ts"
  },
  "dependencies": {
    "@mcp-ui/server": "^5.16.3",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "preact": "^10.19.0",
    "preact-render-to-string": "^6.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/preact": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.19.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
