# Playtomic API Configuration
# Get credentials from Playtomic support
PLAYTOMIC_CLIENT_ID=your_client_id_here
PLAYTOMIC_CLIENT_SECRET=your_client_secret_here
PLAYTOMIC_API_BASE=https://api.playtomic.io/v1
PLAYTOMIC_RATE_LIMIT_PER_MIN=1
PLAYTOMIC_SPORT_ID=1

# Geocoding Configuration
# Options: 'nominatim' (free) or 'google' (requires API key)
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# Caching Configuration (optional - defaults shown)
CACHE_TTL_VENUES=86400
CACHE_TTL_AVAILABILITY=300
CACHE_TTL_GEOCODING=604800

# Server Configuration
NODE_ENV=development
PORT=3000
